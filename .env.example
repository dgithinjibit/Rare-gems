# Dung Craft Environment Configuration
# Copy this file to .env.local and fill in your values

# ===========================================
# APPLICATION
# ===========================================
VITE_APP_URL=http://localhost:5173
VITE_APP_ENV=development
VITE_APP_VERSION=1.0.0

# ===========================================
# SUPABASE (Database & Auth)
# Get these from your Supabase project settings
# ===========================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side only (do NOT prefix with VITE_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===========================================
# AUTHENTICATION
# Generate secure random strings for these
# ===========================================
JWT_SECRET=your-256-bit-jwt-secret-change-this
REFRESH_SECRET=your-256-bit-refresh-secret-change-this

# Session configuration
SESSION_COOKIE_NAME=dc_session
SESSION_MAX_AGE=604800

# ===========================================
# REDIS (Upstash - for caching & rate limiting)
# Get these from your Upstash dashboard
# ===========================================
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# ===========================================
# BLOB STORAGE (Vercel Blob - for avatars)
# Automatically provided when you enable Vercel Blob
# ===========================================
BLOB_READ_WRITE_TOKEN=vercel_blob_xxxxx

# ===========================================
# MONITORING & ANALYTICS
# ===========================================
# Sentry (Error tracking)
VITE_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Vercel Analytics (automatically enabled on Vercel)
VERCEL_ANALYTICS_ID=xxxxx

# ===========================================
# FEATURE FLAGS
# ===========================================
VITE_ENABLE_LEADERBOARD=true
VITE_ENABLE_ACHIEVEMENTS=true
VITE_ENABLE_MULTIPLAYER=false
VITE_MAINTENANCE_MODE=false

# ===========================================
# VIBE JAM (Game Jam specific)
# ===========================================
VITE_JAM_USERNAME=YourUsername
VITE_JAM_PORTAL_URL=https://jam.pieter.com/portal/2026

# ===========================================
# DEVELOPMENT ONLY
# ===========================================
# Enable detailed logging
VITE_DEBUG=true

# Mock API responses (for offline development)
VITE_MOCK_API=false

# Skip authentication (DANGER: development only!)
VITE_SKIP_AUTH=false
